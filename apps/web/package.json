{
  "name": "@cv/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3021",
    "build": "next build && npm run pdf",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint --no-cache .",
    "typecheck": "tsc --noEmit",
    "i18n:pull": "node ./scripts/i18n-pull.mjs",
    "i18n:push": "tolgee push --config ./tolgee.config.cjs --force-mode OVERRIDE",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf .next",
    "pdf": "node ./scripts/generate-pdf.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "design-system": "github:zigordev/design-system#v0.1.46",
    "kafkajs": "^2.2.4",
    "next": "^16.3.5",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "source-map-js": "^1.2.1",
    "unleash-client": "^6.12.1",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@tolgee/cli": "2.20.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "jszip": "^3.10.1",
    "playwright-core": "^1.49.1",
    "typescript": "^5.1.3",
    "vitest": "^5.0.0"
  }
}
