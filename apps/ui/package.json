{
  "name": "@cv/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3021",
    "build": "next build && npm run pdf",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint --no-cache .",
    "typecheck": "tsc --noEmit",
    "i18n:pull": "node ./scripts/i18n-pull.mjs",
    "i18n:push": "tolgee push --config ./tolgee.config.cjs --force-mode OVERRIDE",
    "test": "vitest run",
    "clean": "rm -rf .next",
    "pdf": "node ./scripts/generate-pdf.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "design-system": "github:zigordev/design-system#v0.1.42",
    "kafkajs": "^2.2.4",
    "next": "^16.3.3",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.1",
    "@tolgee/cli": "2.20.0",
    "@types/node": "^20.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "jszip": "^3.10.1",
    "playwright-core": "^1.49.1",
    "typescript": "^5.1.3",
    "vitest": "^4.1.11"
  }
}
