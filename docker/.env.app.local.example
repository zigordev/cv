# Copy to docker/.env.app.local and fill in. Never commit the real file.
NEXT_PUBLIC_RELEASE=dev
OPENBAO_TOKEN=
TOLGEE_PROJECT_ID=
NOTIFICATIONS_KAFKA_BROKERS=platform-redpanda:9092
NOTIFICATIONS_EMAIL_TOPIC=notification.email.requested.v1

#UNLEASH
# Leave both empty to run on the declared defaults with no flag server.
UNLEASH_URL=http://unleash:4242
UNLEASH_TOKEN=

#ASK
# The question box needs ANTHROPIC_API_KEY in OpenBao at kv/cv and the cv-ask
# flag on; without the key it stays hidden. Spend stops at the monthly limit.
# With no flag server, FLAG_CV_ASK=true turns the box on for this stack only.
FLAG_CV_ASK=
ASK_BUDGET_LIMIT_USD=10
ASK_LOG_QUESTIONS=true
ASK_LOG_ANSWERS=false
