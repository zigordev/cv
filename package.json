{
  "name": "cv",
  "version": "0.11.1",
  "private": true,
  "description": "Personal CV web app (editorial single-page)",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare-husky.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"apps/web/messages/*.json\" \"apps/web/tolgee.config.cjs\" \"scripts/**/*.{mjs,json}\" \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"docs/**/*.md\" \"*.{json,md}\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"apps/web/messages/*.json\" \"apps/web/tolgee.config.cjs\" \"scripts/**/*.{mjs,json}\" \".github/**/*.{yml,yaml}\" \"docker/**/*.{yml,yaml}\" \"docs/**/*.md\" \"*.{json,md}\" \".release-please-config.json\" \".release-please-manifest.json\"",
    "test:secrets:gitleaks": "./scripts/precommit-gitleaks.sh",
    "ci:quality:local": "npm run format:check && npm run lint && npm run typecheck && npm run test:cov && npm run build",
    "precommit:checks": "npm run test:secrets:gitleaks && npm run ci:quality:local",
    "local:up": "bash ./scripts/local-stack.sh up",
    "local:dev": "bash ./scripts/local-stack.sh dev",
    "local:down": "bash ./scripts/local-stack.sh down",
    "local:reset": "bash ./scripts/local-stack.sh reset",
    "local:token": "bash ../platform-ops/scripts/provision-local-app-token.sh cv",
    "i18n:push:local": "bash ./scripts/i18n-push.sh",
    "audit": "npm audit --audit-level=high",
    "audit:prod:gate": "node ./scripts/audit-prod-gate.mjs",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "overrides": {
    "postcss": "8.5.27",
    "proxy-from-env": "2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
